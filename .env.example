# Relay — variáveis de ambiente
#
# Copie para .env (backend) e/ou dashboard/.env.local (dashboard) e preencha.
# Nunca commite o arquivo .env real.

# --- P3 · Motor de validação (extração estruturada) ---
OPENAI_API_KEY=

# --- P3 · Integração Ambiguous (memória longitudinal) ---
AMBIGUOUS_API_KEY=
AMBIGUOUS_BASE_URL=

# --- P4 · Notificação Slack (Incoming Webhook) ---
SLACK_WEBHOOK_URL=

# --- P4 · TTS (texto-para-voz da intervenção) ---
# Nome exato da chave depende do provedor escolhido por P4 (ex: ElevenLabs,
# Azure Speech, OpenAI TTS). Deixe só uma preenchida e avise o time se o
# provedor mudar — não é uma mudança de contrato de dados, mas afeta o setup
# de todo mundo que for rodar a demo localmente.
TTS_API_KEY=

# --- Backend (P2) ---
# Porta do orquestrador FastAPI, usada pelo dashboard para montar as URLs abaixo.
BACKEND_PORT=8000

# --- Dashboard (P4) ---
# URLs que o Next.js usa para falar com o backend. NEXT_PUBLIC_* fica exposto
# ao browser — nunca coloque segredo (chave de API) com esse prefixo.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
