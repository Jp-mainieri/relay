# Relay — variáveis de ambiente
#
# Copie para .env (backend) e/ou dashboard/.env.local (dashboard) e preencha.
# Nunca commite o arquivo .env real.

# --- P3 · Motor de validação (extração estruturada) ---
# Caminho padrão: OpenAI direta.
OPENAI_API_KEY=
# Opcional. Sobrescreve o modelo (default: gpt-4o-mini).
OPENAI_MODEL=

# --- P3 · Contingência via OpenRouter ---
# Caminho alternativo, usado APENAS se OPENROUTER_API_KEY estiver preenchida —
# serve para quando a chave OpenAI fica sem crédito. Deixe em branco para
# continuar batendo direto na OpenAI.
# Atenção: o motor usa Structured Outputs em modo `json_schema` estrito
# (chat.completions.parse com o AnalyzeResponse), não o modo `json_object`.
# Conectividade OK não garante que esse modo funcione através do proxy —
# confirme com `python -m backend.harness_p3` antes de confiar na demo.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Formato provedor/modelo, ex: openai/gpt-4o-mini
LLM_MODEL=openai/gpt-4o-mini

# Teto de tempo da chamada ao LLM. Precisa caber dentro de
# VALIDATION_TIMEOUT_SECONDS (8.0s) do orquestrador — ver backend/main.py.
OPENAI_TIMEOUT_SECONDS=6.0

# --- P3 · Integração Ambiguous (memória longitudinal) ---
AMBIGUOUS_API_KEY=
AMBIGUOUS_BASE_URL=
# Opcional. Máximo efetivo de 1.5s para não ultrapassar o orçamento do P2.
AMBIGUOUS_TIMEOUT_SECONDS=1.5

# --- P4 · Notificação Slack (Incoming Webhook) ---
SLACK_WEBHOOK_URL=

# --- P4 · TTS (texto-para-voz da intervenção) ---
# Nome exato da chave depende do provedor escolhido por P4 (ex: ElevenLabs,
# Azure Speech, OpenAI TTS). Deixe só uma preenchida e avise o time se o
# provedor mudar — não é uma mudança de contrato de dados, mas afeta o setup
# de todo mundo que for rodar a demo localmente.
TTS_API_KEY=

# --- Backend (P2) ---
# Porta do orquestrador FastAPI, usada pelo dashboard para montar as URLs abaixo.
BACKEND_PORT=8000

# --- Dashboard (P4) ---
# URLs que o Next.js usa para falar com o backend. NEXT_PUBLIC_* fica exposto
# ao browser — nunca coloque segredo (chave de API) com esse prefixo.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
